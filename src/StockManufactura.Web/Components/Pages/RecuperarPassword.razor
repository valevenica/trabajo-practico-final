@page "/cuenta/recuperar"
@layout EmptyLayout
@attribute [AllowAnonymous]
@rendermode RenderModes.Interactivo
@inherits OwningComponentBase
@using Microsoft.Extensions.DependencyInjection

<PageTitle>Recuperar contraseña · StockManufactura</PageTitle>

<div class="auth-card">
    <img src="img/logo.png" alt="" class="auth-logo" />
    <h1>Recuperar contraseña</h1>
    <p class="muted">Le enviaremos un código al correo de su perfil.</p>

    <label for="correo">Correo de su perfil</label>
    <input id="correo" type="email" @bind="_correo" disabled="@_codigoEnviado" autocomplete="email" />
    @if (!_codigoEnviado)
    {
        <button class="btn btn-secondary btn-block" disabled="@_ocupado" @onclick="EnviarCodigoAsync">Enviar código</button>
    }
    else
    {
        <label for="codigo">Código recibido</label>
        <input id="codigo" @bind="_codigo" maxlength="6" inputmode="numeric" autocomplete="one-time-code" />

        <label for="nueva">Nueva contraseña (mínimo 8 caracteres)</label>
        <input id="nueva" type="password" @bind="_nueva" autocomplete="new-password" />

        <label for="confirmacion">Confirmar nueva contraseña</label>
        <input id="confirmacion" type="password" @bind="_confirmacion" autocomplete="new-password" />

        <button class="btn btn-primary btn-block" disabled="@_ocupado" @onclick="RestablecerAsync">Restablecer contraseña</button>
        <button class="btn btn-link" disabled="@_ocupado" @onclick="EnviarCodigoAsync">Reenviar código</button>
    }

    @if (!string.IsNullOrEmpty(_mensaje))
    {
        <div class="alert @(_esError ? "alert-error" : "alert-warning")">@_mensaje</div>
    }

    <a class="auth-link" href="login">Volver al ingreso</a>
</div>

@code {
    private string _correo = string.Empty;
    private string _codigo = string.Empty;
    private string _nueva = string.Empty;
    private string _confirmacion = string.Empty;
    private bool _codigoEnviado;
    private bool _ocupado;
    private bool _esError;
    private string _mensaje = string.Empty;

    private IPasswordRecoveryService Recuperacion => ScopedServices.GetRequiredService<IPasswordRecoveryService>();

    private Task EnviarCodigoAsync() => EjecutarAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(_correo) || !_correo.Contains('@'))
        {
            Error("Ingrese el correo de su perfil.");
            return;
        }

        await Recuperacion.RequestCodeAsync(_correo.Trim());
        _codigoEnviado = true;
        Aviso("Si el correo corresponde a un usuario activo, recibirá un código de 6 dígitos válido por 15 minutos. Revise también la carpeta de correo no deseado.");
    });

    private Task RestablecerAsync() => EjecutarAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(_codigo)) { Error("Ingrese el código recibido."); return; }
        if (string.IsNullOrWhiteSpace(_nueva) || _nueva.Length < 8) { Error("La nueva contraseña debe tener al menos 8 caracteres."); return; }
        if (!string.Equals(_nueva, _confirmacion, StringComparison.Ordinal)) { Error("Las contraseñas no coinciden."); return; }

        var usuario = await Recuperacion.ResetWithCodeAsync(_correo.Trim(), _codigo.Trim(), _nueva);
        _codigoEnviado = false;
        _codigo = _nueva = _confirmacion = string.Empty;
        Aviso($"Contraseña restablecida. Ya puede ingresar con el usuario «{usuario}» y la nueva contraseña.");
    });

    private async Task EjecutarAsync(Func<Task> accion)
    {
        if (_ocupado) { return; }
        _ocupado = true;
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            Error(ex.Message);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void Error(string mensaje) { _mensaje = mensaje; _esError = true; }

    private void Aviso(string mensaje) { _mensaje = mensaje; _esError = false; }
}
