@page "/cuenta/password"
@attribute [Authorize]
@inject WebSession Session
@inject IUserManagementService UserManagementService
@inject NavigationManager Navigation

<PageTitle>Cambiar contraseña · StockManufactura</PageTitle>

<div class="page-header"><h1>Cambiar contraseña</h1></div>

<div class="card narrow">
    @if (Session.PasswordChangePending)
    {
        <div class="alert alert-warning">Su contraseña es inicial o temporal: debe reemplazarla para usar el resto del sistema.</div>
    }

    <EditForm Model="Input" FormName="cambiar-password" OnValidSubmit="CambiarAsync" method="post">
        <label for="actual">Contraseña actual</label>
        <InputText id="actual" type="password" @bind-Value="Input.Actual" autocomplete="current-password" />

        <label for="nueva">Nueva contraseña (mínimo 8 caracteres)</label>
        <InputText id="nueva" type="password" @bind-Value="Input.Nueva" autocomplete="new-password" />

        <label for="confirmacion">Repetir nueva contraseña</label>
        <InputText id="confirmacion" type="password" @bind-Value="Input.Confirmacion" autocomplete="new-password" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-error">@_error</div>
        }

        <button type="submit" class="btn btn-primary">Guardar contraseña</button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm] private PasswordInput Input { get; set; } = default!;

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        await Session.GetUsuarioAsync();
    }

    private async Task CambiarAsync()
    {
        var usuario = Session.Usuario;
        if (usuario is null)
        {
            Navigation.NavigateTo("login", forceLoad: true);
            return;
        }

        if (Input.Nueva != Input.Confirmacion)
        {
            _error = "La confirmación no coincide con la nueva contraseña.";
            return;
        }

        if (Input.Nueva == Input.Actual)
        {
            _error = "La nueva contraseña debe ser distinta de la actual.";
            return;
        }

        try
        {
            await UserManagementService.ChangePasswordAsync(usuario.Id, Input.Actual, Input.Nueva, Session.Actor);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _error = ex.Message;
            return;
        }

        Navigation.NavigateTo("", forceLoad: true);
    }

    private sealed class PasswordInput
    {
        public string Actual { get; set; } = string.Empty;
        public string Nueva { get; set; } = string.Empty;
        public string Confirmacion { get; set; } = string.Empty;
    }
}
