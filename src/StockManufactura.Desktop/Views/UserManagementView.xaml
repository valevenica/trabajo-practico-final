<UserControl x:Class="StockManufactura.Desktop.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="860">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Mis datos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Mi perfil" FontSize="15" FontWeight="SemiBold" Margin="0 0 0 12" />

                        <StackPanel Margin="0 0 0 8">
                            <TextBlock Text="Nombre" />
                            <TextBox Text="{Binding MyNombre, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                        </StackPanel>

                        <StackPanel Margin="0 0 0 8">
                            <TextBlock Text="Email" />
                            <TextBox Text="{Binding MyEmail, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                            <Button Content="Guardar mis datos" Command="{Binding SaveMyDataCommand}" Width="170" Height="34" Margin="0 0 10 0" />
                            <Button Content="Ir a gestión de usuarios" Command="{Binding OpenUserAdminTabCommand}" Width="210" Height="34" Margin="0 0 10 0" />
                            <Button Content="Ir a gestión de roles" Command="{Binding OpenRoleAdminTabCommand}" Width="180" Height="34" Visibility="{Binding CanManageRoles, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <Button Content="Cambiar contraseña" Command="{Binding ToggleMyChangePasswordCommand}"
                                Width="170" Height="34" HorizontalAlignment="Left" Margin="0 20 0 0" />

                        <StackPanel Margin="0 12 0 0" Visibility="{Binding IsMyChangePasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Contraseña actual" />
                            <PasswordBox x:Name="MyCurrentPasswordBox" PasswordChanged="OnMyCurrentPasswordChanged" Height="32" Margin="0 4 0 8" />

                            <TextBlock Text="Nueva contraseña" />
                            <Grid Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="MyNewPasswordBox" PasswordChanged="OnMyNewPasswordChanged" Grid.Column="0"
                                             Visibility="{Binding HideMyNewPassword, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBox Text="{Binding MyNewPassword, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0"
                                         Visibility="{Binding ShowMyNewPassword, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="👁" Grid.Column="1" Width="32" Height="32" Margin="4 0 0 0"
                                        Command="{Binding ToggleShowMyNewPasswordCommand}" />
                            </Grid>

                            <Button Content="Guardar contraseña" Command="{Binding SaveMyPasswordCommand}" Width="170" Height="34" Margin="0 12 0 0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Administrar usuarios">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0 0 16 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0 0 0 12">
                            <Button DockPanel.Dock="Right" Content="+" Width="30" Height="30" FontWeight="Bold"
                                    Command="{Binding NewUserCommand}" ToolTip="Nuevo usuario" />
                            <TextBlock Text="Usuarios" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" MinHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Email}" />
                                        <TextBlock Text="{Binding RolNombre, StringFormat=Rol: {0}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Gestión de usuario" FontSize="15" FontWeight="SemiBold" Margin="0 0 0 12" />

                            <TextBlock Text="Nombre" />
                            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 8" />

                            <TextBlock Text="Email" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 8" />

                            <TextBlock Text="Rol" />
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Nombre" Height="32" Margin="0 4 0 8" />

                            <CheckBox Content="Usuario activo" IsChecked="{Binding EsActivo}" Margin="0 2 0 8" />

                            <Button Content="Cambiar contraseña" Command="{Binding ToggleChangePasswordCommand}"
                                    Width="170" Height="34" HorizontalAlignment="Left" Margin="0 8 0 0"
                                    Visibility="{Binding EsExistente, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Margin="0 8 0 0" Visibility="{Binding IsChangePasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Nueva contraseña" />
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="NewPasswordBox" PasswordChanged="OnNewPasswordChanged" Grid.Column="0"
                                                 Visibility="{Binding HideNewPassword, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0"
                                             Visibility="{Binding ShowNewPassword, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button Content="👁" Grid.Column="1" Width="32" Height="32" Margin="4 0 0 0"
                                            Command="{Binding ToggleShowNewPasswordCommand}" />
                                </Grid>

                                <Button Content="Guardar contraseña" Command="{Binding SaveNewPasswordCommand}" Width="170" Height="34"
                                        Margin="0 8 0 0" HorizontalAlignment="Left"
                                        Visibility="{Binding EsExistente, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <Button Content="Guardar" Command="{Binding SaveCommand}" Width="140" Height="34" Margin="0 16 0 0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Roles y permisos">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0 0 16 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0 0 0 12">
                            <Button DockPanel.Dock="Right" Content="+" Width="30" Height="30" FontWeight="Bold"
                                    Command="{Binding ToggleNewRolePanelCommand}" ToolTip="Nuevo rol" />
                            <TextBlock Text="Roles" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding RolesForAdmin}" SelectedItem="{Binding SelectedRoleForPermissions}" MinHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Permisos del rol" FontSize="15" FontWeight="SemiBold" Margin="0 0 0 12" />
                            <ItemsControl ItemsSource="{Binding RolePermissions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0 4 0 4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Guardar permisos" Command="{Binding SaveRolePermissionsCommand}" Width="160" Height="34" Margin="0 16 0 0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="2" Width="240" Margin="16 0 0 0" Padding="14" Background="#F2F4F7" CornerRadius="6"
                            Visibility="{Binding IsNewRolePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel Margin="0 0 0 12">
                                <Button DockPanel.Dock="Right" Content="✕" Width="26" Height="26"
                                        Command="{Binding ToggleNewRolePanelCommand}" ToolTip="Cerrar" />
                                <TextBlock Text="Nuevo rol" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Nombre" />
                            <TextBox Text="{Binding NewRoleName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 8" />
                            <TextBlock Text="Descripción" />
                            <TextBox Text="{Binding NewRoleDescription, UpdateSourceTrigger=PropertyChanged}" Height="60"
                                     Margin="0 4 0 8" TextWrapping="Wrap" AcceptsReturn="True" />
                            <Button Content="Crear rol" Command="{Binding CreateRoleCommand}" Height="34" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 12 0 0">
            <Button Content="Volver" Command="{Binding BackCommand}" Height="34" Width="120"
                    Visibility="{Binding ShowBackButton, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding StatusMessage}" Margin="12 8 0 0" Foreground="#B54708" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
