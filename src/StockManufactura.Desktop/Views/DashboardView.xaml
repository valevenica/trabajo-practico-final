<UserControl x:Class="StockManufactura.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#050505" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>

        <Style x:Key="KpiDetailStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SalesVariationStyle" TargetType="TextBlock" BasedOn="{StaticResource KpiDetailStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SalesVariationPositive}" Value="True">
                    <Setter Property="Foreground" Value="#067647" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SalesVariationNegative}" Value="True">
                    <Setter Property="Foreground" Value="#B42318" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashboardFilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#4C4538" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="DashboardFilterComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2A2432" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,22,26,28" Background="{StaticResource BackgroundSoftLightBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <!-- Aviso de cambio de contraseña pendiente (contraseña inicial o temporal) -->
                <Border Margin="0,0,0,14" Padding="14,10" CornerRadius="8"
                        Background="#FEF0C7" BorderBrush="#F79009" BorderThickness="1"
                        Visibility="{Binding IsPasswordChangePending, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Foreground="#93370D" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,160,0"
                                   Text="Su contraseña es inicial o fue asignada por un administrador. Cámbiela para habilitar el resto del sistema." />
                        <Button Content="Cambiar contraseña" Command="{Binding NavigateToMyAccountCommand}"
                                HorizontalAlignment="Right" Height="30" MinWidth="150"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>

                <!-- Encabezado: el período aplica a los indicadores y al listado de pedidos -->
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Resumen de ventas" FontSize="20" FontWeight="Bold" Foreground="#050505" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Período" Style="{StaticResource DashboardFilterLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Background="#FFFFFF" BorderBrush="#B48B3A" BorderThickness="1" CornerRadius="8" Padding="8,0">
                            <ComboBox Style="{StaticResource DashboardFilterComboStyle}"
                                      MinWidth="170"
                                      ItemsSource="{Binding PeriodOptions}"
                                      SelectedItem="{Binding SelectedPeriod, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Label" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Indicadores comerciales -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource DashboardMetricCardStyle}" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="VENTAS DEL MES" Style="{StaticResource DashboardMetricTitleStyle}" />
                        <TextBlock Text="{Binding SalesTotalText}" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding SalesVariationText}" Style="{StaticResource SalesVariationStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardMetricCardStyle}" Margin="3,0,6,0">
                    <StackPanel>
                        <TextBlock Text="PEDIDOS DEL MES" Style="{StaticResource DashboardMetricTitleStyle}" />
                        <TextBlock Text="{Binding OrdersInPeriodText}" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding OpenOrdersText}" Style="{StaticResource KpiDetailStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardMetricCardStyle}" Margin="6,0,3,0">
                    <StackPanel>
                        <TextBlock Text="TICKET PROMEDIO" Style="{StaticResource DashboardMetricTitleStyle}" />
                        <TextBlock Text="{Binding AverageTicketText}" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding AverageTicketDetailText}" Style="{StaticResource KpiDetailStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardMetricCardStyle}" Margin="9,0,0,0">
                    <StackPanel>
                        <TextBlock Text="% DE GANANCIA" Style="{StaticResource DashboardMetricTitleStyle}" />
                        <TextBlock Text="{Binding GrossMarginText}" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="{Binding GrossMarginDetailText}" Style="{StaticResource KpiDetailStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Aviso compacto de stock crítico: solo aparece cuando hay faltantes -->
            <Border Grid.Row="2" Margin="0,0,0,16" Padding="14,8" CornerRadius="8"
                    Background="#FEF3F2" BorderBrush="#FDA29B" BorderThickness="1"
                    Visibility="{Binding HasCriticalStock, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Foreground="#912018" FontWeight="SemiBold"
                               Text="{Binding CriticalStockCount, StringFormat=⚠  {0} producto(s) o insumo(s) por debajo del stock mínimo}" />
                    <Button Content="Ver faltantes" Command="{Binding NavigateToShortagesCommand}"
                            HorizontalAlignment="Right" Height="28" MinWidth="110"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Border>

            <!-- Pedidos -->
            <Border Grid.Row="3" Style="{StaticResource DashboardPanelStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Pedidos" FontSize="18" FontWeight="Bold" Foreground="#050505" VerticalAlignment="Center" />
                        <Button Content="+  Nuevo pedido" Command="{Binding NavigateToProductionOrdersCommand}"
                                ToolTip="Crear una nueva orden de producción (pedido)"
                                Height="34" MinWidth="150" FontWeight="SemiBold"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <Border Margin="0,0,0,12" Padding="12" Background="#FFFFFF" BorderBrush="#D7CBAE" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Filtro desplegable multi-estado -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Filtrar por estado" Style="{StaticResource DashboardFilterLabelStyle}" />
                                <Grid>
                                    <ToggleButton x:Name="StatusFilterToggle"
                                                  Height="34" MinWidth="190"
                                                  Background="#FFFFFF" BorderBrush="#B48B3A" BorderThickness="1"
                                                  Padding="10,0" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FilterSummary}" VerticalAlignment="Center" FontSize="13" />
                                            <TextBlock Text=" ▾" VerticalAlignment="Center" FontSize="11" Foreground="#888" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=StatusFilterToggle}"
                                           PlacementTarget="{Binding ElementName=StatusFilterToggle}"
                                           Placement="Bottom" StaysOpen="False"
                                           PopupAnimation="Slide" AllowsTransparency="True">
                                        <Border Background="#FFFFFF" BorderBrush="#B48B3A" BorderThickness="1"
                                                CornerRadius="6" Padding="10,8" MinWidth="190">
                                            <StackPanel>
                                                <CheckBox Content="Todos" IsChecked="{Binding SelectAllStatusFilters, Mode=TwoWay}"
                                                          Margin="0,0,0,6" FontSize="13" FontWeight="SemiBold" />
                                                <Separator Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding OrderStatusFilters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      Margin="0,0,0,4" FontSize="13" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Ordenar tabla" Style="{StaticResource DashboardFilterLabelStyle}" />
                                <Border Background="#FFFFFF" BorderBrush="#B48B3A" BorderThickness="1" CornerRadius="8" Padding="8,0">
                                    <ComboBox Style="{StaticResource DashboardFilterComboStyle}"
                                              ItemsSource="{Binding OrderSortOptions}"
                                              SelectedItem="{Binding SelectedOrderSortOption, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Buscar por ID o cliente" Style="{StaticResource DashboardFilterLabelStyle}" />
                                <TextBox Text="{Binding OrderIdSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" MinWidth="150" Padding="10,0" VerticalContentAlignment="Center"
                                         BorderBrush="#B48B3A" BorderThickness="1" Background="#FFFFFF" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border CornerRadius="8" Background="#EEEDEA" BorderBrush="#C6C0B8" BorderThickness="1" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding OrdersView}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  VerticalGridLinesBrush="#D9D3C8"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowBackground="#FCFBF8"
                                  AlternatingRowBackground="#F5F3EF"
                                  IsReadOnly="True"
                                  RowHeight="40"
                                  ColumnHeaderHeight="40"
                                  FontSize="13">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource TableHeaderBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="BorderBrush" Value="#3DFFFFFF" />
                                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <Style x:Key="IdOrdenCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="10,0,26,0" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID ORDEN" Binding="{Binding Codigo}" Width="Auto" MinWidth="90" CellStyle="{StaticResource IdOrdenCellStyle}" ElementStyle="{StaticResource CenteredCellStyle}" />
                                <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="*" MinWidth="160" />
                                <DataGridTextColumn Header="CLIENTE" Binding="{Binding ClientName}" Width="*" MinWidth="130" />
                                <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource CenteredCellStyle}" />
                                <DataGridTemplateColumn Header="ESTADO" Width="Auto" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBackground}" CornerRadius="7" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Estado}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold" TextAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource CenteredCellStyle}" />
                                <DataGridTextColumn Header="COSTO" Binding="{Binding Costo}" Width="Auto" MinWidth="75" ElementStyle="{StaticResource CenteredCellStyle}" />
                                <DataGridTemplateColumn Header="ACCIONES" Width="Auto" MinWidth="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button IsEnabled="{Binding CanAdvance}"
                                                        Command="{Binding DataContext.AdvanceOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="36" Height="36" Margin="0,0,6,0"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        ToolTip="{Binding AdvanceLabel}">
                                                    <TextBlock Text="{Binding AdvanceIcon}" FontSize="16" />
                                                </Button>
                                                <Button IsEnabled="{Binding CanCancel}"
                                                        Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="36" Height="36"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        ToolTip="Cancelar orden">
                                                    <TextBlock Text="✕" FontSize="16" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
