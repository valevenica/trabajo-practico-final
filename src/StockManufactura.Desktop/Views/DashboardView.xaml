<UserControl x:Class="StockManufactura.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:StockManufactura.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="520">
    <UserControl.Resources>
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter" />
    </UserControl.Resources>
    <Grid Margin="24" Background="{StaticResource BackgroundSoftLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="PANEL DE CONTROL" Style="{StaticResource ScreenTitleStyle}" />
        <TextBlock Grid.Row="1" Text="Bienvenido al sistema de manufactura" Margin="0 10 0 0" FontStyle="Italic" FontFamily="Georgia" Foreground="{StaticResource TextMutedBrush}" />

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0 18 0 0">
            <StackPanel>
                <Border Background="{StaticResource BackgroundDarkMetalBrush}" CornerRadius="4" Padding="10 6">
                    <TextBlock Text="ESTADO DEL SISTEMA" Foreground="{StaticResource SecondaryAccentBrush}" FontWeight="Bold" FontFamily="{StaticResource HeaderFontFamily}" />
                </Border>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusMessageStyle}" Margin="0 8 0 0" />
                <Grid Margin="0 10 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Último backup" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Grid.Column="1" Text="Última sincronización" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Grid.Column="2" Text="Última actualización del dólar" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Grid.Row="1" Text="{Binding LastBackupText}" Margin="0 4 0 0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastDriveSyncText}" Margin="0 4 0 0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LastDollarUpdateText}" Margin="0 4 0 0" />

                    <TextBlock Grid.Row="2" Text="Internet" FontWeight="SemiBold" Margin="0 12 0 0" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Tamaño DB" FontWeight="SemiBold" Margin="0 12 0 0" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Versión" FontWeight="SemiBold" Margin="0 12 0 0" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Grid.Row="3" Text="{Binding InternetText}" Margin="0 4 0 0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DatabaseSizeText}" Margin="0 4 0 0" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding VersionText}" Margin="0 4 0 0" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0 14 0 0">
                    <Border Background="#F6EEF3" BorderBrush="{StaticResource SecondaryAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10 6" Margin="0 0 8 0">
                        <TextBlock Text="{Binding ProductCountText, StringFormat='Productos: {0}'}" />
                    </Border>
                    <Border Background="#F6EEF3" BorderBrush="{StaticResource SecondaryAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10 6" Margin="0 0 8 0">
                        <TextBlock Text="{Binding ResourceCountText, StringFormat='Recursos: {0}'}" />
                    </Border>
                    <Border Background="#F6EEF3" BorderBrush="{StaticResource SecondaryAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10 6" Margin="0 0 8 0">
                        <TextBlock Text="{Binding CustomerCountText, StringFormat='Clientes: {0}'}" />
                    </Border>
                    <Button Content="Refrescar" Margin="8 0 0 0" Command="{Binding RefreshStatusCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                    <Border CornerRadius="6" Padding="10 8" Margin="0 0 8 0" BorderBrush="{StaticResource SecondaryAccentBrush}" BorderThickness="1" Background="{Binding BackupHealthy, Converter={StaticResource BoolToBrushConverter}, FallbackValue=#F3F4F6}">
                        <TextBlock Text="{Binding BackupStatusText, StringFormat='Backup: {0}'}" />
                    </Border>
                    <Border CornerRadius="6" Padding="10 8" Margin="0 0 8 0" BorderBrush="{StaticResource SecondaryAccentBrush}" BorderThickness="1" Background="{Binding SyncHealthy, Converter={StaticResource BoolToBrushConverter}, FallbackValue=#F3F4F6}">
                        <TextBlock Text="{Binding CloudStatusText}" />
                    </Border>
                    <Border CornerRadius="6" Padding="10 8" BorderBrush="{StaticResource SecondaryAccentBrush}" BorderThickness="1" Background="#F3F4F6">
                        <TextBlock Text="{Binding StatusToneText, StringFormat='Estado: {0}'}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0 18 0 0">
            <Button Content="Productos"
                Width="160"
                Margin="0 0 12 0"
                HorizontalAlignment="Left"
                IsEnabled="{Binding CanViewProducts}"
                Command="{Binding NavigateToProductsCommand}"
                Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Recetas BOM"
                Width="160"
                Margin="0 0 12 0"
                HorizontalAlignment="Left"
                IsEnabled="{Binding CanEditBom}"
                Command="{Binding NavigateToBomCommand}"
                Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Recursos"
                Width="160"
                Margin="0 0 12 0"
                HorizontalAlignment="Left"
                Command="{Binding NavigateToResourcesCommand}"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Proveedores"
                Width="160"
                Margin="0 0 12 0"
                HorizontalAlignment="Left"
                IsEnabled="{Binding CanManageProviders}"
                Command="{Binding NavigateToProvidersCommand}"
                Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Órdenes Producción"
                Width="180"
                Margin="0 0 12 0"
                HorizontalAlignment="Left"
                IsEnabled="{Binding CanManageProductionOrders}"
                Command="{Binding NavigateToProductionOrdersCommand}"
                Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Configuración Monetaria"
                Width="220"
                HorizontalAlignment="Left"
                Command="{Binding NavigateToMonetaryConfigurationCommand}"
                Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0 12 0 0">
            <Button Content="Bitácora"
                Width="160"
                Margin="0 0 12 0"
                HorizontalAlignment="Left"
                Command="{Binding NavigateToAuditLogCommand}"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Usuarios"
                Width="140"
                Margin="0 0 12 0"
                HorizontalAlignment="Left"
                IsEnabled="{Binding CanManageUsers}"
                Command="{Binding NavigateToUserManagementCommand}"
                Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Backups"
                Width="160"
                Margin="0 0 12 0"
                HorizontalAlignment="Left"
                Command="{Binding NavigateToBackupsCommand}"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Historial Costos"
                Width="180"
                HorizontalAlignment="Left"
                Command="{Binding NavigateToProductCostHistoryCommand}"
                Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
