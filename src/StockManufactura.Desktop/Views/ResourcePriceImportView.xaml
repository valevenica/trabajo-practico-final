<UserControl x:Class="StockManufactura.Desktop.Views.ResourcePriceImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:StockManufactura.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:ResourcePriceImportStatusToBrushConverter x:Key="StatusToBrushConverter" />
    </UserControl.Resources>
    <Grid Margin="16" Background="{StaticResource BackgroundSoftLightBrush}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <Border Style="{StaticResource CardBorderStyle}" Margin="0 0 0 10">
                <StackPanel>
                    <Border Background="{StaticResource BackgroundDarkMetalBrush}" Padding="8" CornerRadius="4" Margin="0 0 0 10">
                        <TextBlock Text="CARGA MASIVA DE PRECIOS" Foreground="{StaticResource SecondaryAccentBrush}" FontWeight="SemiBold" />
                    </Border>

                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0 0 0 10"
                               Text="Elegí el proveedor y un archivo Excel (.xlsx) con 2 columnas: Código de proveedor y Precio (la primera fila se toma como encabezado y se ignora). Solo se actualizan los insumos que tengan ese código cargado en 'Proveedores del insumo'." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0 0 8 0">
                            <TextBlock Text="Proveedor" FontSize="11" Foreground="Gray" />
                            <ComboBox ItemsSource="{Binding Proveedores}" SelectedItem="{Binding SelectedProveedor}"
                                      DisplayMemberPath="Nombre" Height="30" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Archivo" FontSize="11" Foreground="Gray" />
                            <Button Content="Seleccionar archivo Excel..." Command="{Binding SeleccionarArchivoCommand}"
                                    Height="30" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ArchivoSeleccionado}" FontSize="11" Foreground="Gray" Margin="0 6 0 0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Border Background="{StaticResource BackgroundDarkMetalBrush}" Padding="8" CornerRadius="4" Margin="0 0 0 10">
                        <TextBlock Text="Vista previa" Foreground="{StaticResource SecondaryAccentBrush}" FontWeight="SemiBold" />
                    </Border>

                    <DataGrid ItemsSource="{Binding Filas}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" MinHeight="150" MaxHeight="320"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fila" Binding="{Binding Fila}" Width="50" />
                            <DataGridTextColumn Header="Código proveedor" Binding="{Binding CodigoProveedor}" Width="120" />
                            <DataGridTextColumn Header="Insumo" Binding="{Binding RecursoNombre}" Width="*" />
                            <DataGridTextColumn Header="Precio actual" Binding="{Binding PrecioActual, StringFormat={}{0:0.00}}" Width="90" />
                            <DataGridTextColumn Header="Precio nuevo" Binding="{Binding Precio, StringFormat={}{0:0.00}}" Width="90" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Mensaje" Binding="{Binding Mensaje}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Confirmar importación" Command="{Binding ConfirmarImportacionCommand}"
                            Height="34" Margin="0 12 0 0" HorizontalAlignment="Left" Padding="16 0"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    <TextBlock Text="{Binding StatusMessage}" Margin="0 10 0 0" Style="{StaticResource StatusMessageStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
