<UserControl x:Class="StockManufactura.Desktop.Views.BackupManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Backups" FontSize="18" FontWeight="Bold" />

        <Grid Grid.Row="1" Margin="0 12 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Margin="0 0 8 0" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Grid.Column="1" Margin="0 0 8 0" VerticalAlignment="Center" Content="Automático" IsChecked="{Binding Automatic}" />
            <TextBox Grid.Column="2" Margin="0 0 8 0" Text="{Binding KeepCopies, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="3" Margin="0 0 8 0" Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="4" Margin="0 0 8 0" Content="Guardar" Command="{Binding SaveSettingsCommand}" Height="34" />
            <Button Grid.Column="5" Margin="0 0 8 0" Content="Backup Manual" Command="{Binding ManualBackupCommand}" Height="34" />
            <Button Grid.Column="6" Content="Actualizar" Command="{Binding RefreshCommand}" Height="34" />
        </Grid>

        <Grid Grid.Row="2" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Margin="0 0 8 0" Text="{Binding RestoreFilePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Restaurar" Command="{Binding RestoreBackupCommand}" Height="34" />
        </Grid>

        <!-- Sincronización bidireccional con el servicio en la nube -->
        <Border Grid.Row="3" Margin="0 0 0 12" Padding="12" CornerRadius="4"
                Background="#F4F7FB" BorderBrush="#B0C4DE" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Sincronización con la nube" FontWeight="Bold" Margin="0 0 0 4" />
                <TextBlock TextWrapping="Wrap" Foreground="#3A3540" Margin="0 0 0 10"
                           Text="Las copias se intercambian con la carpeta que el cliente de escritorio del proveedor (Google Drive, OneDrive) replica contra el servicio remoto. Con la sincronización bidireccional activa, además de subir las copias de este equipo se descargan las que otros equipos hayan subido. Si la carpeta no está disponible, el sistema sigue funcionando con las copias locales." />

                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Carpeta de la nube" VerticalAlignment="Center" Margin="0 0 8 0" />
                    <TextBox Grid.Column="1" Margin="0 0 12 0"
                             Text="{Binding CloudFolder, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Ejemplo: C:\Users\usuario\Google Drive\Backups Integra" />
                    <TextBlock Grid.Column="2" Text="Proveedor" VerticalAlignment="Center" Margin="0 0 8 0" />
                    <TextBox Grid.Column="3" Text="{Binding CloudProvider, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0 0 16 0"
                              Content="Sincronizar con la nube" IsChecked="{Binding CloudEnabled}" />
                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0 0 16 0"
                              Content="Bidireccional (también descargar)" IsChecked="{Binding CloudBidirectional}"
                              IsEnabled="{Binding CloudEnabled}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="#3A3540" Text="{Binding CloudSyncSummary}" />
                    <Button Grid.Column="3" Content="Sincronizar ahora" Height="34" MinWidth="140"
                            Command="{Binding SynchronizeCloudCommand}" IsEnabled="{Binding CloudEnabled}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Margin="0 0 0 12" Padding="12" CornerRadius="4"
                Background="#FDECEA" BorderBrush="#D32F2F" BorderThickness="1"
                Visibility="{Binding CanResetDatabase, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Zona de peligro" FontWeight="Bold" Foreground="#B71C1C" Margin="0 0 0 4" />
                <TextBlock TextWrapping="Wrap" Foreground="#B71C1C" Margin="0 0 0 8"
                           Text="Restablecer la base de datos borra TODOS los productos, insumos, proveedores, órdenes, historial y auditoría de forma irreversible (se genera un backup automático antes de borrar). Solo quedan los roles y el usuario administrador base." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0 0 8 0"
                             Text="{Binding ResetConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Escribí BORRAR TODO para habilitar el restablecimiento" />
                    <Button Grid.Column="1" Content="Restablecer base de datos" Command="{Binding ResetDatabaseCommand}"
                            Height="34" Background="#D32F2F" Foreground="White" BorderBrush="#B71C1C" />
                </Grid>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="5" ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, Converter={StaticResource UtcToLocal}, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100" />
                <DataGridTextColumn Header="Ruta" Binding="{Binding RutaArchivo}" Width="*" />
                <DataGridTextColumn Header="Tamaño" Binding="{Binding TamanoBytes}" Width="90" />
                <DataGridTextColumn Header="Exitoso" Binding="{Binding Exitoso}" Width="80" />
                <DataGridTextColumn Header="Mensaje" Binding="{Binding Mensaje}" Width="250" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
