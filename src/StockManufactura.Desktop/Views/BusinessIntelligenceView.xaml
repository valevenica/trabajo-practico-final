<UserControl x:Class="StockManufactura.Desktop.Views.BusinessIntelligenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:StockManufactura.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:ScaleToGridLengthConverter x:Key="ScaleToGridLength" />
        <converters:SeverityToBrushConverter x:Key="SeverityToBrush" />

        <Style x:Key="KpiCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#141019" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#141019" />
        </Style>

        <Style x:Key="ChartSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,2,0,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Barra horizontal: la escala ya viene normalizada entre 0 y 1 desde la capa de aplicación. -->
        <DataTemplate x:Key="BarRowTemplate">
            <Grid Margin="0,0,0,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Etiqueta}" FontSize="12" FontWeight="SemiBold"
                           Foreground="#2A2432" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ValorFormateado}" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryAccentBrush}" Margin="10,0,0,0" />

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="14" Margin="0,4,0,0"
                      ToolTip="{Binding Detalle}">
                    <Border Background="#EDE8E0" CornerRadius="7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Escala, Converter={StaticResource ScaleToGridLength}}" />
                            <ColumnDefinition Width="{Binding Escala, Converter={StaticResource ScaleToGridLength}, ConverterParameter=resto}" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PrimaryAccentBrush}" CornerRadius="7" MinWidth="3" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,28">

            <!-- Encabezado y selector de período -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Inteligencia de negocio" FontSize="22" FontWeight="Bold" Foreground="#141019" />
                    <TextBlock Text="{Binding PeriodoTexto, StringFormat=Indicadores y alertas para la toma de decisiones · {0}}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="Período" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                    <ComboBox MinWidth="180" Height="34" VerticalContentAlignment="Center"
                              ItemsSource="{Binding PeriodOptions}"
                              SelectedItem="{Binding SelectedPeriod}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <Button Grid.Column="2" Content="Actualizar" VerticalAlignment="Bottom" Height="34" MinWidth="100"
                        Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#8C1D18" Margin="0,0,0,10" TextWrapping="Wrap" />

            <!-- Indicadores clave -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="COSTO PROMEDIO POR PRODUCTO" Style="{StaticResource KpiCaptionStyle}" />
                        <TextBlock Text="{Binding CostoPromedioTexto}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="VARIACIÓN DE COSTOS DEL PERÍODO" Style="{StaticResource KpiCaptionStyle}" />
                        <TextBlock Text="{Binding VariacionCostoTexto}" Style="{StaticResource KpiValueStyle}"
                                   Foreground="{Binding VariacionCostoTono, Converter={StaticResource SeverityToBrush}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MARGEN PROMEDIO CONFIGURADO" Style="{StaticResource KpiCaptionStyle}" />
                        <TextBlock Text="{Binding MargenPromedioTexto}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="COTIZACIÓN VIGENTE DEL DÓLAR" Style="{StaticResource KpiCaptionStyle}" />
                        <TextBlock Text="{Binding CotizacionTexto}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CAPITAL INMOVILIZADO EN INSUMOS" Style="{StaticResource KpiCaptionStyle}" />
                        <TextBlock Text="{Binding ValorInventarioInsumosTexto}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="VALOR DE PRODUCTOS TERMINADOS" Style="{StaticResource KpiCaptionStyle}" />
                        <TextBlock Text="{Binding ValorInventarioProductosTexto}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="PRODUCCIÓN VALORIZADA DEL PERÍODO" Style="{StaticResource KpiCaptionStyle}" />
                        <TextBlock Text="{Binding ProduccionValorizadaTexto}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ÓRDENES FINALIZADAS / EN PROCESO" Style="{StaticResource KpiCaptionStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OrdenesFinalizadasTexto}" Style="{StaticResource KpiValueStyle}" />
                            <TextBlock Text=" / " Style="{StaticResource KpiValueStyle}" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding OrdenesEnProcesoTexto}" Style="{StaticResource KpiValueStyle}"
                                       Foreground="{StaticResource SecondaryAccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Alertas para la toma de decisiones -->
            <Border Style="{StaticResource DashboardPanelStyle}" Margin="0,8,0,16">
                <StackPanel>
                    <TextBlock Text="Alertas y recomendaciones" Style="{StaticResource ChartTitleStyle}" />
                    <TextBlock Text="Situaciones detectadas automáticamente sobre los datos del sistema, con la acción sugerida."
                               Style="{StaticResource ChartSubtitleStyle}" />
                    <ItemsControl ItemsSource="{Binding Alertas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                                        Background="{Binding Severidad, Converter={StaticResource SeverityToBrush}, ConverterParameter=fondo}"
                                        BorderBrush="{Binding Severidad, Converter={StaticResource SeverityToBrush}}"
                                        BorderThickness="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding Severidad, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding Detalle}" FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="#3A3540" />
                                        <TextBlock Text="{Binding Recomendacion, StringFormat=→ {0}}" FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" FontStyle="Italic" Foreground="#3A3540" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Gráficos -->
            <UniformGrid Columns="2">
                <Border Style="{StaticResource DashboardPanelStyle}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Costo de fabricación por producto" Style="{StaticResource ChartTitleStyle}" />
                        <TextBlock Text="Los productos más caros de fabricar concentran el impacto de cualquier aumento de insumos."
                                   Style="{StaticResource ChartSubtitleStyle}" />
                        <ItemsControl ItemsSource="{Binding CostoPorProducto}" ItemTemplate="{StaticResource BarRowTemplate}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardPanelStyle}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Mayores aumentos de costo" Style="{StaticResource ChartTitleStyle}" />
                        <TextBlock Text="Variación porcentual acumulada en el período. Son los candidatos a revisar el precio de venta."
                                   Style="{StaticResource ChartSubtitleStyle}" />
                        <ItemsControl ItemsSource="{Binding MayoresAumentos}" ItemTemplate="{StaticResource BarRowTemplate}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardPanelStyle}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Evolución del costo promedio" Style="{StaticResource ChartTitleStyle}" />
                        <TextBlock Text="Promedio de los costos recalculados en cada uno de los últimos seis meses."
                                   Style="{StaticResource ChartSubtitleStyle}" />
                        <ItemsControl ItemsSource="{Binding EvolucionCosto}" ItemTemplate="{StaticResource BarRowTemplate}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardPanelStyle}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Capital inmovilizado por insumo" Style="{StaticResource ChartTitleStyle}" />
                        <TextBlock Text="Stock actual valorizado al precio vigente. Orienta dónde conviene reducir compras."
                                   Style="{StaticResource ChartSubtitleStyle}" />
                        <ItemsControl ItemsSource="{Binding InsumosPorValorInmovilizado}" ItemTemplate="{StaticResource BarRowTemplate}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardPanelStyle}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Órdenes de producción por estado" Style="{StaticResource ChartTitleStyle}" />
                        <TextBlock Text="Distribución del total histórico de órdenes." Style="{StaticResource ChartSubtitleStyle}" />
                        <ItemsControl ItemsSource="{Binding OrdenesPorEstado}" ItemTemplate="{StaticResource BarRowTemplate}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardPanelStyle}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Actividad auditada por módulo" Style="{StaticResource ChartTitleStyle}" />
                        <TextBlock Text="Eventos registrados en la bitácora durante el período, por módulo del sistema."
                                   Style="{StaticResource ChartSubtitleStyle}" />
                        <ItemsControl ItemsSource="{Binding ActividadPorModulo}" ItemTemplate="{StaticResource BarRowTemplate}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
