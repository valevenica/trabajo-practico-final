<UserControl x:Class="StockManufactura.Desktop.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="860">
    <Grid Margin="20" Background="{StaticResource BackgroundSoftLightBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0 0 16 0" Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock Text="PRODUCTOS" Style="{StaticResource SectionTitleStyle}" Margin="0 0 0 12" />
            <Border Background="{StaticResource BackgroundDarkMetalBrush}" Padding="8" CornerRadius="4" Margin="0 0 0 8">
                <TextBlock Text="Listado" Foreground="{StaticResource SecondaryAccentBrush}" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="Buscar por código o nombre:" Margin="0 0 0 4" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0 0 0 8" Padding="8" />
            <ListBox ItemsSource="{Binding FilteredProducts}" SelectedItem="{Binding SelectedProduct}" Height="320">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 2 0 2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Codigo, StringFormat=Código: {0}}" />
                                <TextBlock Text="{Binding PrecioSugeridoActual, StringFormat=Precio final: {0:F2}}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="🕒" ToolTip="Ver historial de costos"
                                    Command="{Binding DataContext.ViewCostHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="28" Height="28" FontSize="13" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <Grid Margin="0 0 0 12">
                <TextBlock Text="GESTION DE PRODUCTO" Style="{StaticResource SectionTitleStyle}" />
                <Button Content="+" Command="{Binding NewProductCommand}" ToolTip="Nuevo producto"
                        Width="30" Height="30" FontSize="16" FontWeight="Bold"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <TextBlock Text="Código" />
            <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 8" />

            <TextBlock Text="Nombre" />
            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 8" />

            <TextBlock Text="Descripción" />
            <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" Height="56" Margin="0 4 0 8" AcceptsReturn="True" TextWrapping="Wrap" />

            <UniformGrid Rows="1" Columns="3" Margin="0 0 0 8">
                <StackPanel Margin="0 0 8 0">
                    <TextBlock Text="Costo fabricación (calculado)" />
                    <TextBox Text="{Binding CostoFabricacionCalculado}" Height="32" Margin="0 4 0 0" IsReadOnly="True" />
                </StackPanel>
                <StackPanel Margin="0 0 8 0">
                    <TextBlock Text="Margen" />
                    <TextBox Text="{Binding Margen, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Precio final" />
                    <TextBox Text="{Binding PrecioSugerido, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="Componentes del producto (insumos o sub-productos)" FontWeight="SemiBold" Margin="0 6 0 6" />
            <DataGrid ItemsSource="{Binding RecipeItems}"
                      SelectedItem="{Binding SelectedRecipeItem}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      Height="150"
                      Margin="0 0 0 8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Componente" Binding="{Binding Recurso}" Width="*" />
                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="70" />
                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat={}{0:0.00}}" Width="90" />
                    <DataGridTextColumn Header="Costo unidad" Binding="{Binding CostoUnitario, StringFormat={}{0:0.00}}" Width="100" />
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding CostoTotal, StringFormat={}{0:0.00}}" Width="100" />
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" ToolTip="Quitar componente"
                                        Command="{Binding DataContext.RemoveRecipeItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="28" Height="28" FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Margin="0 0 0 12" IsEnabled="{Binding CanEditRecipeItems}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0 0 8 0">
                    <TextBlock Text="Insumo o producto" FontSize="11" Foreground="Gray" />
                    <ComboBox ItemsSource="{Binding AvailableComponents}" SelectedItem="{Binding SelectedComponent}" Height="32" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0 0 8 0">
                    <TextBlock Text="Cantidad" FontSize="11" Foreground="Gray" />
                    <TextBox Text="{Binding ComponentQuantity, UpdateSourceTrigger=PropertyChanged}" Height="32" />
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding RecipeItemActionLabel}" Command="{Binding SaveRecipeItemCommand}"
                        Height="32" Margin="0 0 8 0" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Column="3" Content="Cancelar" Command="{Binding CancelRecipeItemEditCommand}"
                        Height="32" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <CheckBox Content="Producto activo" IsChecked="{Binding Activo}" Margin="0 2 0 8" />

            <TextBlock Text="Observaciones" />
            <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" Height="56" Margin="0 4 0 8" AcceptsReturn="True" TextWrapping="Wrap" />

            <Button Content="Guardar" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" Width="160" Style="{StaticResource PrimaryButtonStyle}" />

            <TextBlock Text="{Binding StatusMessage}" Margin="0 12 0 0" Style="{StaticResource StatusMessageStyle}" />
        </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
