<UserControl x:Class="StockManufactura.Desktop.Views.ProviderManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="980">
    <Grid Margin="20" Background="{StaticResource BackgroundSoftLightBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0 0 16 0" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
            <TextBlock Text="PROVEEDORES" Style="{StaticResource SectionTitleStyle}" Margin="0 0 0 12" />
            <Border Background="{StaticResource BackgroundDarkMetalBrush}" Padding="8" CornerRadius="4" Margin="0 0 0 8">
                <TextBlock Text="Listado" Foreground="{StaticResource SecondaryAccentBrush}" FontWeight="SemiBold" />
            </Border>
            <ListBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" Height="380">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Cuit, StringFormat=CUIT: {0}}" />
                            <TextBlock Text="{Binding Activo, StringFormat=Activo: {0}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Nuevo proveedor" Command="{Binding NewProviderCommand}" Margin="0 12 0 0" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Activar / Desactivar" Command="{Binding ToggleActiveCommand}" Margin="0 8 0 0" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Volver" Command="{Binding BackCommand}" Margin="0 8 0 0" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
            <TextBlock Text="GESTION DE PROVEEDOR" Style="{StaticResource SectionTitleStyle}" Margin="0 0 0 12" />

            <UniformGrid Rows="1" Columns="3" Margin="0 0 0 8">
                <StackPanel Margin="0 0 8 0">
                    <TextBlock Text="Nombre" />
                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
                <StackPanel Margin="0 0 8 0">
                    <TextBlock Text="Razón social" />
                    <TextBox Text="{Binding RazonSocial, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="CUIT" />
                    <TextBox Text="{Binding Cuit, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
            </UniformGrid>

            <UniformGrid Rows="1" Columns="3" Margin="0 0 0 8">
                <StackPanel Margin="0 0 8 0">
                    <TextBlock Text="Dirección" />
                    <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
                <StackPanel Margin="0 0 8 0">
                    <TextBlock Text="Ciudad" />
                    <TextBox Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Provincia" />
                    <TextBox Text="{Binding Provincia, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
            </UniformGrid>

            <UniformGrid Rows="1" Columns="3" Margin="0 0 0 8">
                <StackPanel Margin="0 0 8 0">
                    <TextBlock Text="País" />
                    <TextBox Text="{Binding Pais, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
                <StackPanel Margin="0 0 8 0">
                    <TextBlock Text="Teléfono" />
                    <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Email" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 0" />
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="Persona de contacto" />
            <TextBox Text="{Binding PersonaContacto, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 8" />

            <CheckBox Content="Proveedor activo" IsChecked="{Binding Activo}" Margin="0 0 0 8" />

            <TextBlock Text="Observaciones" />
            <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" Height="60" Margin="0 4 0 8" TextWrapping="Wrap" AcceptsReturn="True" />

            <Button Content="Guardar" Command="{Binding SaveCommand}" Width="160" Style="{StaticResource PrimaryButtonStyle}" />

            <TextBlock Text="{Binding StatusMessage}" Margin="0 12 0 0" Style="{StaticResource StatusMessageStyle}" />
        </StackPanel>
        </Border>
    </Grid>
</UserControl>
