<UserControl x:Class="StockManufactura.Desktop.Views.MonetaryConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Configuración Monetaria" FontSize="24" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 14 0 10" VerticalAlignment="Center">
            <TextBlock Text="Cotización actual:" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CurrentRate}" Margin="6 0 18 0" />
            <TextBlock Text="Última actualización:" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LastUpdate}" Margin="6 0 18 0" />
            <TextBlock Text="Fuente:" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Source}" Margin="6 0 0 0" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Cotización manual:" VerticalAlignment="Center" Margin="0 0 8 0" />
            <TextBox Grid.Column="1" Margin="0 0 10 0" Height="34"
                     Text="{Binding ManualRateInput, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Ingresá el valor del dólar blue manualmente" />
            <Button Grid.Column="2" Margin="0 0 8 0" Height="34" Width="120"
                    Content="Guardar manual" Command="{Binding ManualUpdateCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="3" Margin="0 0 8 0" Height="34" Width="160"
                    Content="🔄 Actualizar blue"
                    Command="{Binding AutomaticUpdateCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    ToolTip="Obtiene el precio de venta del dólar blue desde DolarHoy" />
            <Button Grid.Column="4" Margin="0 0 8 0" Height="34" Width="150"
                    Content="★ Marcar prioritaria"
                    Command="{Binding SetPrioritariaCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    ToolTip="Marca la cotización seleccionada como la que se usa para calcular precios" />
            <Button Grid.Column="5" Height="34" Width="90"
                    Content="Historial" Command="{Binding RefreshHistoryCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0 0 0 8"
                   Style="{StaticResource StatusMessageStyle}" />

        <DataGrid Grid.Row="4" ItemsSource="{Binding History}"
                  SelectedItem="{Binding SelectedHistoryRate}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Prioritaria" Binding="{Binding EsPrioritaria}" Width="80" />
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="150" />
                <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat={}{0:0.00}}" Width="100" />
                <DataGridTextColumn Header="Fuente" Binding="{Binding Fuente}" Width="140" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="120" />
                <DataGridTextColumn Header="Automática" Binding="{Binding Automatica}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
