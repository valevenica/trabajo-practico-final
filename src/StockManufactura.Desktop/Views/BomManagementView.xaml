<UserControl x:Class="StockManufactura.Desktop.Views.BomManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="980">
    <Grid Margin="20" Background="{StaticResource BackgroundSoftLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0 0 0 12">
            <TextBlock Text="RECETAS BOM" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
            <TextBlock Text="  Producto:" VerticalAlignment="Center" Margin="16 0 6 0" />
            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Nombre" Width="320" Height="32" />
            <Button Content="Volver" Command="{Binding BackCommand}" Width="120" Height="32" Margin="12 0 0 0" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Margin="0 0 12 0" Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundDarkMetalBrush}" Padding="8" CornerRadius="4" Margin="0 0 0 8">
                    <TextBlock Text="Items de receta" Foreground="{StaticResource SecondaryAccentBrush}" FontWeight="SemiBold" />
                </Border>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0 4 0 4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Recurso.Nombre}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Cantidad, StringFormat=Cantidad: {0:F4}}" />
                                <TextBlock Grid.Column="2" Text="{Binding CostoParcialManual, StringFormat=Costo: {0:F4}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
            <TextBlock Text="EDITAR ITEM" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0 0 0 8" />

                <TextBlock Text="Recurso" />
                <ComboBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" DisplayMemberPath="Nombre" Height="32" Margin="0 4 0 8" />

                <TextBlock Text="Cantidad" />
                <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 8" />

                <TextBlock Text="Costo parcial manual" />
                <TextBox Text="{Binding CostoParcialManual, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 4 0 8" />

                <TextBlock Text="Observaciones" />
                <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" Height="62" Margin="0 4 0 8" TextWrapping="Wrap" AcceptsReturn="True" />

                <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                    <Button Content="Nuevo" Command="{Binding NewItemCommand}" Width="90" Height="32" Margin="0 0 8 0" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Guardar" Command="{Binding SaveItemCommand}" Width="100" Height="32" Margin="0 0 8 0" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="Eliminar" Command="{Binding RemoveItemCommand}" Width="100" Height="32" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0 12 0 0">
            <TextBlock Text="{Binding TotalReceta, StringFormat=Costo total receta: {0}}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" />
            <TextBlock Text="{Binding StatusMessage}" Margin="0 6 0 0" Style="{StaticResource StatusMessageStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
