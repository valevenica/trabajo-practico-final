<UserControl x:Class="StockManufactura.Desktop.Views.SpecialResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="16" Background="{StaticResource BackgroundSoftLightBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Columna izquierda: listado de insumos especiales -->
        <Border Grid.Column="0" Margin="0 0 10 0" Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundDarkMetalBrush}"
                        Padding="8" CornerRadius="4" Margin="0 0 0 8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+" Width="26" Height="26" FontWeight="Bold"
                                Command="{Binding ToggleNewResourcePanelCommand}" ToolTip="Nuevo insumo especial" />
                        <TextBlock Text="INSUMOS ESPECIALES" Foreground="{StaticResource SecondaryAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="8" Margin="0 0 0 8" Background="#F2F4F7" CornerRadius="4"
                        Visibility="{Binding IsNewResourcePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Código" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NuevoCodigo, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0 2 0 6" />
                        <TextBlock Text="Nombre" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0 2 0 6" />
                        <TextBlock Text="Categoría" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NuevaCategoria, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0 2 0 6" />
                        <TextBlock Text="Unidad de medida (ej: kWh)" FontSize="11" Foreground="Gray" />
                        <TextBox Text="{Binding NuevaUnidadMedida, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0 2 0 8" />
                        <Button Content="Crear insumo especial" Command="{Binding CreateResourceCommand}"
                                Height="30" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding SpecialResources}" SelectedItem="{Binding SelectedResource}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 4">
                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Codigo}" FontSize="11" Foreground="Gray" />
                                <TextBlock Text="{Binding UnidadMedida}" FontSize="11" Foreground="{StaticResource SecondaryAccentBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Columna derecha: tramos de precio y cálculo -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0 0 0 10">
                    <StackPanel>
                        <Border Background="{StaticResource BackgroundDarkMetalBrush}" Padding="8" CornerRadius="4" Margin="0 0 0 10">
                            <TextBlock Text="Tramos de precio" Foreground="{StaticResource SecondaryAccentBrush}" FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Text="Definí cuánto cuesta cada unidad según el rango de consumo. Dejá &quot;Hasta&quot; vacío en el último tramo para indicar &quot;sin límite&quot;. El costo final se calcula automáticamente en cada producto, según cuánto consuma su receta de este insumo."
                                   TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0 0 0 8" />

                        <ItemsControl ItemsSource="{Binding Tramos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 0 0 6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0 0 6 0">
                                            <TextBlock Text="Hasta (cantidad)" FontSize="10" Foreground="Gray" />
                                            <TextBox Text="{Binding CantidadHasta, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6 0 6 0">
                                            <TextBlock Text="Precio por unidad" FontSize="10" Foreground="Gray" />
                                            <TextBox Text="{Binding PrecioPorUnidad, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Width="28" Height="28" VerticalAlignment="Bottom"
                                                Command="{Binding DataContext.RemoveTramoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ Agregar tramo" Command="{Binding AddTramoCommand}"
                                Height="28" Margin="0 4 0 0" HorizontalAlignment="Left" Padding="12 0"
                                Style="{StaticResource SecondaryButtonStyle}" />

                        <Button Content="Guardar tramos" Command="{Binding SaveTramosCommand}"
                                Height="30" Margin="0 12 0 0" HorizontalAlignment="Left" Padding="12 0"
                                Style="{StaticResource PrimaryButtonStyle}" />

                        <TextBlock Text="{Binding StatusMessage}" Margin="0 10 0 0" Style="{StaticResource StatusMessageStyle}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
