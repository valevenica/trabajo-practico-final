<Window x:Class="StockManufactura.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="560"
        Height="360"
        Background="#101114"
        Topmost="True"
        AllowsTransparency="False">
    <Grid>
        <Border Margin="20" CornerRadius="12" Background="#16181D" BorderBrush="#2A2E36" BorderThickness="1">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="10" Background="#0E0F12" BorderBrush="#2C313A" BorderThickness="1" Padding="14">
                    <Grid>
                        <Image x:Name="LogoImage" Stretch="Uniform" />
                        <TextBlock x:Name="FallbackText"
                                   Visibility="Collapsed"
                                   Text="StockManufactura"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#A40057"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1"
                           Margin="0 14 0 0"
                           Text="Cargando sistema..."
                           Foreground="#D2D6DE"
                           FontSize="15"
                           HorizontalAlignment="Center" />

                <ProgressBar Grid.Row="2"
                             Margin="0 12 0 0"
                             Height="6"
                             IsIndeterminate="True"
                             Foreground="#A40057"
                             Background="#2A2E36" />
            </Grid>
        </Border>
    </Grid>
</Window>
