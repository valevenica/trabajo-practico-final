<Window x:Class="StockManufactura.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:StockManufactura.Desktop.Views"
        xmlns:viewModels="clr-namespace:StockManufactura.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="620" Width="860" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Background="{StaticResource BackgroundSoftLightBrush}">
        <Border DockPanel.Dock="Top"
                Visibility="{Binding IsShellVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{StaticResource CardSurfaceBrush}"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" MinWidth="1" MinHeight="1" MaxWidth="1" MaxHeight="1" Visibility="Collapsed">
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <Image x:Name="HeaderLogoImage" Stretch="Uniform" />
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="INTEGRA MANUFACTURING" FontSize="37" FontFamily="Georgia" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Text="Sistema de Gestión Integral de Inventario, Producción y Costos" FontSize="20" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock FontSize="16" HorizontalAlignment="Right" Text="{Binding CurrentUserName, StringFormat=Usuario: {0}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left"
                Width="160"
                Visibility="{Binding IsShellVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{StaticResource BackgroundDarkMetalBrush}"
                BorderBrush="#4A4B50"
                BorderThickness="0,0,1,0"
                Padding="12,16">
            <Border.Resources>
                <Style x:Key="SidebarMenuButtonStyle" TargetType="Button">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="#7A1C52" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="White" BlurRadius="14" ShadowDepth="0" Opacity="1" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Expander IsExpanded="True" Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="Dashboard" Foreground="White" FontWeight="Bold" />
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <Button Content="Panel principal" Margin="0,0,0,6" Command="{Binding NavigateDashboardCommand}" Tag="{Binding IsDashboardSelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                        </StackPanel>
                    </Expander>

                    <Expander IsExpanded="True" Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="Stock" Foreground="White" FontWeight="Bold" />
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <Button Content="Productos" Margin="0,0,0,6" Command="{Binding NavigateProductsCommand}" Tag="{Binding IsProductsSelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                            <Button Content="Insumos" Margin="0,0,0,6" Command="{Binding NavigateResourcesCommand}" Tag="{Binding IsResourcesSelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                        </StackPanel>
                    </Expander>

                    <Expander IsExpanded="False" Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="Proveedores" Foreground="White" FontWeight="Bold" />
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <Button Content="Proveedores" Margin="0,0,0,6" Command="{Binding NavigateProvidersCommand}" Tag="{Binding IsProvidersSelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                        </StackPanel>
                    </Expander>

                    <Expander IsExpanded="False" Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="Producción" Foreground="White" FontWeight="Bold" />
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <Button Content="Órdenes" Margin="0,0,0,6" Command="{Binding NavigateProductionOrdersCommand}" Tag="{Binding IsProductionOrdersSelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                            <Button Content="Recetas BOM" Margin="0,0,0,6" Command="{Binding NavigateBomCommand}" Tag="{Binding IsBomSelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                            <Button Content="Historial costos" Margin="0,0,0,6" Command="{Binding NavigateCostsCommand}" Tag="{Binding IsCostsSelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                        </StackPanel>
                    </Expander>

                    <Expander IsExpanded="False" Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="Finanzas" Foreground="White" FontWeight="Bold" />
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <Button Content="Configuración monetaria" Margin="0,0,0,6" Command="{Binding NavigateMonetaryCommand}" Tag="{Binding IsMonetarySelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                            <Button Content="Backups" Margin="0,0,0,6" Command="{Binding NavigateBackupsCommand}" Tag="{Binding IsBackupsSelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                        </StackPanel>
                    </Expander>

                    <Expander IsExpanded="False" Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="Administración" Foreground="White" FontWeight="Bold" />
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <Button Content="Usuarios" Margin="0,0,0,6" Command="{Binding NavigateUsersCommand}" Tag="{Binding IsUsersSelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                            <Button Content="Bitácora" Margin="0,0,0,6" Command="{Binding NavigateAuditCommand}" Tag="{Binding IsAuditSelected}" Style="{StaticResource SidebarMenuButtonStyle}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
                    <views:LoginView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                    <views:DashboardView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ResourceManagementViewModel}">
                    <views:ResourceManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:MonetaryConfigurationViewModel}">
                    <views:MonetaryConfigurationView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:AuditLogViewModel}">
                    <views:AuditLogView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:BackupManagementViewModel}">
                    <views:BackupManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ProductCostHistoryViewModel}">
                    <views:ProductCostHistoryView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ProductManagementViewModel}">
                    <views:ProductManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:BomManagementViewModel}">
                    <views:BomManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ProviderManagementViewModel}">
                    <views:ProviderManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ProductionOrderManagementViewModel}">
                    <views:ProductionOrderManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:UserManagementViewModel}">
                    <views:UserManagementView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </DockPanel>
</Window>
