<Window x:Class="StockManufactura.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:StockManufactura.Desktop.Views"
        xmlns:viewModels="clr-namespace:StockManufactura.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="StockManufactura" Height="600" Width="1000">
    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
                    <views:LoginView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                    <views:DashboardView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ResourceManagementViewModel}">
                    <views:ResourceManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:MonetaryConfigurationViewModel}">
                    <views:MonetaryConfigurationView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:AuditLogViewModel}">
                    <views:AuditLogView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:BackupManagementViewModel}">
                    <views:BackupManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ProductCostHistoryViewModel}">
                    <views:ProductCostHistoryView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:UserManagementViewModel}">
                    <views:UserManagementView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</Window>
