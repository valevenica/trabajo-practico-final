<Window x:Class="StockManufactura.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:StockManufactura.Desktop.Views"
        xmlns:viewModels="clr-namespace:StockManufactura.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="760" Width="1240" MinHeight="560" MinWidth="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Background="{StaticResource BackgroundSoftLightBrush}">
        <Border DockPanel.Dock="Top"
                Visibility="{Binding IsShellVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{StaticResource CardSurfaceBrush}"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="8" Background="#FFFFFF" BorderBrush="#DDD" BorderThickness="1" Padding="6" MinWidth="44" MinHeight="44" MaxWidth="64" MaxHeight="64">
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <Image x:Name="HeaderLogoImage" Stretch="Uniform" />
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Integra Manufacturing" FontSize="24" FontFamily="Georgia" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                    <TextBlock Text="Sistema de gestión integral" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding CurrentUserName, StringFormat=Usuario: {0}}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left"
                Width="220"
                Visibility="{Binding IsShellVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{StaticResource BackgroundDarkMetalBrush}"
                BorderBrush="#4A4B50"
                BorderThickness="0,0,1,0"
                Padding="12,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button Content="Dashboard" Margin="0,0,0,8" Command="{Binding NavigateDashboardCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Productos" Margin="0,0,0,8" Command="{Binding NavigateProductsCommand}" IsEnabled="{Binding CanViewProducts}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Recetas BOM" Margin="0,0,0,8" Command="{Binding NavigateBomCommand}" IsEnabled="{Binding CanEditBom}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Recursos" Margin="0,0,0,8" Command="{Binding NavigateResourcesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Proveedores" Margin="0,0,0,8" Command="{Binding NavigateProvidersCommand}" IsEnabled="{Binding CanManageProviders}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Órdenes" Margin="0,0,0,8" Command="{Binding NavigateProductionOrdersCommand}" IsEnabled="{Binding CanManageProductionOrders}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Monetaria" Margin="0,0,0,8" Command="{Binding NavigateMonetaryCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Bitácora" Margin="0,0,0,8" Command="{Binding NavigateAuditCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Backups" Margin="0,0,0,8" Command="{Binding NavigateBackupsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Historial Costos" Margin="0,0,0,8" Command="{Binding NavigateCostsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Usuarios" Margin="0,0,0,8" Command="{Binding NavigateUsersCommand}" IsEnabled="{Binding CanManageUsers}" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
                    <views:LoginView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                    <views:DashboardView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ResourceManagementViewModel}">
                    <views:ResourceManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:MonetaryConfigurationViewModel}">
                    <views:MonetaryConfigurationView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:AuditLogViewModel}">
                    <views:AuditLogView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:BackupManagementViewModel}">
                    <views:BackupManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ProductCostHistoryViewModel}">
                    <views:ProductCostHistoryView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ProductManagementViewModel}">
                    <views:ProductManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:BomManagementViewModel}">
                    <views:BomManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ProviderManagementViewModel}">
                    <views:ProviderManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:ProductionOrderManagementViewModel}">
                    <views:ProductionOrderManagementView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type viewModels:UserManagementViewModel}">
                    <views:UserManagementView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </DockPanel>
</Window>
