<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de punta a punta en navegador (Chrome) contra un servidor web en ejecución. No forma parte de la solución
    para que "dotnet test" no dependa de un navegador ni de un servidor levantado; ver README.md de esta carpeta.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="precios.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
